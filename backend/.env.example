# Local development only. These variables are never bundled into the mobile app.
LUNA_OLLAMA_URL=http://127.0.0.1:11434
LUNA_CHAT_MODEL=qwen3:4b
LUNA_EMBED_MODEL=qwen3-embedding:0.6b
LUNA_GENERATION_ENABLED=true
# Empty token permits loopback clients ONLY. Set a random token before LAN testing.
LUNA_API_TOKEN=
LUNA_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LUNA_MODEL_TIMEOUT=90
# ai:serve chooses mlx automatically. Ordinary backend keeps using Ollama.
LUNA_MODEL_BACKEND=ollama
# Optional paths for a separate training experiment; use absolute paths.
# LUNA_BASE_MODEL_PATH=/absolute/path/to/qwen3-8b-4bit
# LUNA_ADAPTER_PATH=/absolute/path/to/luna-lora
